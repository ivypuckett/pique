{
  "name": "pique",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A src/dev.ts",
    "web": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "test": "deno test -A src/",
    "icon": "rsvg-convert -w 1024 -h 1024 assets/pique.svg -o assets/pique.png"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.6",
    "svelte": "npm:svelte@^5.56.8",
    "svelte/": "npm:/svelte@^5.56.8/",
    "vite": "npm:vite@^8.2.1",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.2.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "daisyui": "npm:daisyui@^5.7.16",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@sigma/pty-ffi": "jsr:@sigma/pty-ffi@^0.42",
    "@xterm/xterm": "npm:@xterm/xterm@^6",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@^0.11",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@earendil-works/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.83",
    "typebox": "npm:typebox@1.3.7",
    "@git-diff-view/svelte": "npm:@git-diff-view/svelte@^0.1.7",
    "@git-diff-view/core": "npm:@git-diff-view/core@^0.1.7"
  },
  "compilerOptions": {
    "types": ["svelte"]
  },
  "desktop": {
    "app": { "name": "pique" },
    "backend": "webview"
  },
  "exports": {}
}
